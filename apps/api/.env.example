NODE_ENV=development
PORT=4000

# Origen(es) permitido(s) por CORS, separados por coma.
# En local: el dev server de Vite. En producción: el dominio de Vercel.
CORS_ORIGIN=http://localhost:5173

# Se conectan a partir de la Fase 5 (Autenticación) / Fase 9 (Inventario).
# Documentados ya para que el servicio en Render tenga listas las variables.
MONGODB_URI=mongodb://localhost:27017/stockc?replicaSet=rs0
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-in-render-dashboard
JWT_REFRESH_SECRET=change-me-in-render-dashboard
