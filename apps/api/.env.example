NODE_ENV=development
PORT=4000

# Origen(es) permitido(s) por CORS, separados por coma.
# En local: el dev server de Vite. En producción: el dominio de Vercel.
CORS_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/stockc?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Firma del access token (JWT, 15 min). El refresh token NO es un JWT: es
# un valor aleatorio opaco guardado hasheado en `sessions` (ver
# docs/05-autenticacion.md), así que no necesita secreto propio.
JWT_ACCESS_SECRET=change-me-in-render-dashboard
